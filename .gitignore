# Secrets and local environment
.env
.env.*
!.env.example
!**/.env.example
**/secrets.env
*.pem
*.key
*.crt
*.p12

# Python environments, caches, and build output
.venv/
.venv-*/
**/.venv/
**/.venv-*/
