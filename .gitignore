**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node.js dependencies and build output
node_modules/
**/node_modules/
.vite/
**/.vite/

# Runtime state and logs
var/
**/var/
*.log
nohup.out

